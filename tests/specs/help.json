[
  {
    "name": "/help يشرح استخدام البوت",
    "steps": [
      {
        "send": { "text": "/help" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "استخدم الأزرار للوصول إلى المواد والمصادر وإرسال الأسئلة.\nيمكنك العودة إلى القائمة في أي وقت عبر /start."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "the Help menu button shows the same help text",
    "steps": [
      {
        "send": { "callback": "menu:help" },
        "expect": [{ "method": "editMessageText" }]
      }
    ]
  }
]
